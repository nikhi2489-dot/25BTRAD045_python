1) Attendance tracker :
Python Program:

students = {}

def add_student():
name = input("Enter student name: ")
students[name] = {"Present": 0, "Absent": 0}
print("Student added successfully!")

def mark_attendance():
name = input("Enter student name: ")

if name in students:
status = input("Enter status (P/A): ").upper()

if status == "P":
students[name]["Present"] += 1
print("Marked Present")
elif status == "A":
students[name]["Absent"] += 1
print("Marked Absent")
else:
print("Invalid status")
else:
print("Student not found")

def display_attendance():
print("\n--- Attendance Details ---")

for name, record in students.items():
total = record["Present"] + record["Absent"]

if total > 0:
percentage = (record["Present"] / total) * 100
else:
percentage = 0

print("Name:", name)
print("Present:", record["Present"])
print("Absent:", record["Absent"])

print("Attendance:", percentage, "%")

def check_shortage():
threshold = float(input("Enter attendance threshold: "))

for name, record in students.items():
total = record["Present"] + record["Absent"]

if total > 0:
percentage = (record["Present"] / total) * 100
else:
percentage = 0

if percentage < threshold:
print(name, "has low attendance:", percentage, "%")

while True:
print("\n1. Add Student")
print("2. Mark Attendance")
print("3. Display Attendance")
print("4. Check Low Attendance")
print("5. Exit")

choice = input("Enter your choice: ")

if choice == "1":
add_student()
elif choice == "2":
mark_attendance()

elif choice == "3":
display_attendance()
elif choice == "4":
check_shortage()
elif choice == "5":
print("Thank you!")
break
else:
print("Invalid choice")

2) sales data analyser:
Python Program :

products = {}

def add_product():
name = input("Enter product name: ")
quantity = int(input("Enter quantity sold: "))
price = float(input("Enter product price: "))

products[name] = {
"Quantity": quantity,
"Price": price
}

print("Product added successfully!")

def update_sales():
name = input("Enter product name: ")

if name in products:
quantity = int(input("Enter additional quantity sold: "))
products[name]["Quantity"] += quantity
print("Sales updated successfully!")
else:
print("Product not found")

def display_sales():
print("\n--- Sales Details ---")
total_sales = 0

for name, details in products.items():
revenue = details["Quantity"] * details["Price"]
total_sales += revenue

print("Product:", name)
print("Quantity:", details["Quantity"])
print("Price:", details["Price"])
print("Revenue:", revenue)

print("Total Sales:", total_sales)

def highest_selling():
if products:
highest = max(products, key=lambda x: products[x]["Quantity"])
print("Highest Selling Product:", highest)
print("Quantity Sold:", products[highest]["Quantity"])
else:
print("No products available")

while True:

print("\n1. Add Product")
print("2. Update Sales")
print("3. Display Sales")
print("4. Highest Selling Product")
print("5. Exit")

choice = input("Enter your choice: ")

if choice == "1":
add_product()
elif choice == "2":
update_sales()
elif choice == "3":
display_sales()
elif choice == "4":
highest_selling()
elif choice == "5":
print("Thank you!")
break
else:
print("Invalid choice")
